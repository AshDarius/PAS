<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Recording Consent</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap">
<style>
  /* Layout: one narrow reading column, large type, choices and Continue pinned to the bottom of the screen. */
  :root {
    --bg: #F3F6F7;
    --surface: #FFFFFF;
    --fg: #13222B;
    --muted: #46596A;
    --line: #CBD6DB;
    --accent: #0A6B63;
    --accent-fg: #FFFFFF;
    --accent-soft: #DDF0ED;
    --focus: #1F5FBF;
    --font: "Atkinson Hyperlegible", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0F1A20;
      --surface: #172730;
      --fg: #E8F0F2;
      --muted: #A6B8C1;
      --line: #2E434E;
      --accent: #4FC7B8;
      --accent-fg: #06201C;
      --accent-soft: #123A35;
      --focus: #7DB0FF;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0F1A20;
    --surface: #172730;
    --fg: #E8F0F2;
    --muted: #A6B8C1;
    --line: #2E434E;
    --accent: #4FC7B8;
    --accent-fg: #06201C;
    --accent-soft: #123A35;
    --focus: #7DB0FF;
    color-scheme: dark;
  }

  html, body { height: 100%; }
  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    font-size: 18px;
    line-height: 1.6;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    padding-block: 0;
  }
  .app {
    min-height: 100%;
    max-width: 34rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
  }
  .sr {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .content { padding-block: 24px 20px; display: flex; flex-direction: column; gap: 20px; }
  .eyebrow {
    margin: 0;
    font-size: 14px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent);
  }
  h1 { margin: 0; font-size: 32px; line-height: 1.15; text-wrap: balance; }
  h2 { margin: 0 0 4px; font-size: 19px; line-height: 1.3; }
  .block p { margin: 0; }
  .legal { margin: 0; font-size: 15px; color: var(--muted); }

  .actions {
    margin-top: auto;
    position: sticky;
    bottom: 0;
    background: var(--bg);
    border-top: 1px solid var(--line);
    padding-block: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tile { display: block; position: relative; min-width: 0; }
  .tile input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .tile-body {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 68px; padding: 8px 10px;
    border: 2px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    font-size: 20px; font-weight: 700;
    transition: background-color 0.12s, border-color 0.12s, color 0.12s;
  }
  .mark {
    flex: none; width: 26px; height: 26px; border-radius: 50%;
    border: 2px solid var(--muted);
    display: grid; place-items: center;
  }
  .mark svg { width: 16px; height: 16px; opacity: 0; }
  .tile input:checked + .tile-body .mark svg { opacity: 1; }
  .tile input:checked + .tile-body .mark { border-color: currentColor; }
  .tile input[value="agree"]:checked + .tile-body {
    background: var(--accent); border-color: var(--accent); color: var(--accent-fg);
  }
  .tile input[value="decline"]:checked + .tile-body {
    background: var(--surface); border-color: var(--fg); color: var(--fg);
  }
  .tile input:focus-visible + .tile-body { outline: 3px solid var(--focus); outline-offset: 3px; }

  .btn {
    width: 100%; min-height: 64px; border: 0; border-radius: 14px;
    font: inherit; font-size: 20px; font-weight: 700;
    background: var(--accent); color: var(--accent-fg);
    cursor: pointer;
  }
  .btn:disabled { background: var(--line); color: var(--muted); cursor: not-allowed; }
  .btn:focus-visible, .link:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .hint { margin: 0; text-align: center; font-size: 15px; color: var(--muted); min-height: 1.6em; }

  .done { display: flex; flex-direction: column; gap: 16px; padding-block: 40px; }
  .done-icon {
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--accent); color: var(--accent-fg);
    display: grid; place-items: center;
  }
  .done-icon svg { width: 32px; height: 32px; }
  .done p { margin: 0; }
  .stamp { font-size: 15px; color: var(--muted); }
  .link {
    align-self: flex-start; background: none; border: 0; padding: 10px 0; min-height: 44px;
    font: inherit; font-size: 17px; font-weight: 700; color: var(--accent); text-decoration: underline; cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) { .tile-body { transition: none; } }
</style>

<div class="app">
  <form id="consent-form" class="app-form" novalidate style="display:flex;flex-direction:column;flex:1">
    <div class="content">
      <p class="eyebrow">Recording consent</p>
      <h1>Before we start, please read this</h1>

      <div class="block">
        <h2>What we record</h2>
        <p>This session may be recorded, including audio and video. We record it to keep an accurate record and to improve our service.</p>
      </div>

      <div class="block">
        <h2>How we protect it</h2>
        <p>European data protection law (GDPR) says we may only record you with your clear consent. We store recordings securely, use them only for the reason above, and keep them no longer than needed.</p>
      </div>

      <div class="block">
        <h2>Your choice</h2>
        <p>By choosing <strong>I agree</strong>, you consent to being recorded. This is your decision. You can withdraw consent at any time and ask us to show or delete your recording. If you choose <strong>No thanks</strong>, we will not record you.</p>
      </div>

      <p class="legal">Basis: GDPR Article 6(1)(a) and Article 7, consent that is freely given, specific and withdrawable.</p>
    </div>

    <div class="actions">
      <fieldset>
        <legend class="sr">Do you agree to be recorded?</legend>
        <label class="tile">
          <input type="radio" name="choice" id="choice-agree" value="agree">
          <span class="tile-body">
            <span class="mark" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg></span>
            <span>I agree</span>
          </span>
        </label>
        <label class="tile">
          <input type="radio" name="choice" id="choice-decline" value="decline">
          <span class="tile-body">
            <span class="mark" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg></span>
            <span>No thanks</span>
          </span>
        </label>
      </fieldset>
      <button type="submit" id="continue" class="btn" disabled>Continue</button>
      <p class="hint" id="hint" aria-live="polite">Choose an option to continue.</p>
    </div>
  </form>

  <section id="done" class="done" hidden aria-live="polite">
    <div class="done-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg></div>
    <h1 id="done-title">Thank you</h1>
    <p id="done-text"></p>
    <p class="stamp" id="done-stamp"></p>
    <button type="button" id="change" class="link">Change my answer</button>
  </section>
</div>

<script>
  (function () {
    var form = document.getElementById('consent-form');
    var done = document.getElementById('done');
    var btn = document.getElementById('continue');
    var hint = document.getElementById('hint');
    var radios = form.querySelectorAll('input[name="choice"]');

    function current() {
      var el = form.querySelector('input[name="choice"]:checked');
      return el ? el.value : null;
    }

    function refresh() {
      var c = current();
      btn.disabled = !c;
      if (c === 'agree') {
        btn.textContent = 'Continue';
        hint.textContent = 'You agree to be recorded. You can withdraw at any time.';
      } else if (c === 'decline') {
        btn.textContent = 'Continue without recording';
        hint.textContent = 'You will not be recorded.';
      } else {
        btn.textContent = 'Continue';
        hint.textContent = 'Choose an option to continue.';
      }
    }

    radios.forEach(function (r) { r.addEventListener('change', refresh); });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var c = current();
      if (!c) return;
      var when = new Date().toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
      document.getElementById('done-title').textContent = c === 'agree' ? 'Thank you' : 'No problem';
      document.getElementById('done-text').textContent = c === 'agree'
        ? 'You agreed to be recorded. You can withdraw your consent at any time.'
        : 'You chose not to be recorded. Nothing will be recorded.';
      document.getElementById('done-stamp').textContent = 'Answer saved ' + when;
      form.hidden = true;
      done.hidden = false;
      window.scrollTo(0, 0);
    });

    document.getElementById('change').addEventListener('click', function () {
      done.hidden = true;
      form.hidden = false;
      window.scrollTo(0, 0);
    });

    refresh();
  })();
</script>

</body></html>
